# Backend Sauta — Configurazione ambiente di esempio
# Copia in .env e compila con valori reali.

# Database (solo PostgreSQL — il datasource Prisma è postgresql)
DATABASE_URL="postgresql://sauta:sauta@localhost:5432/sauta?schema=public"

# Stripe (usa chiavi Restricted/API sk_test_/rk_test_ da https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_inserisci_qui
STRIPE_API_KEY=sk_test_inserisci_qui

# Webhook secret: ottienilo con `stripe listen --forward-to localhost:3001/api/webhook/stripe`
# Stripe CLI stampa il secret whsec_...  — NON usare placeholder
# Accetta più segreti separati da virgola (account piattaforma + connected): whsec_A,whsec_B
STRIPE_WEBHOOK_SECRET=whsec_inserisci_secret_reale_da_stripe_cli

# Secret legacy per integrità/seed e secret separato per i consume token.
# Generali entrambi con `openssl rand -hex 32` e non riutilizzare lo stesso valore.
JWT_SECRET=genera_con_openssl_rand_hex_32
TICKET_JWT_SECRET=genera_un_secondo_segreto_con_openssl_rand_hex_32

# Admin secret per le API admin (header X-Admin-Secret).
# OBBLIGATORIO con NODE_ENV=production (il server non parte senza).
# Genera con `openssl rand -hex 32`
ADMIN_SECRET=genera_con_openssl_rand_hex_32

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://console.localhost:3001
BASE_URL=http://localhost:3001

# Trust proxy: lascia false se il backend è esposto direttamente (default,
# altrimenti il rate-limit per-IP è aggirabile via X-Forwarded-For spoofato).
# In produzione usa un numero esplicito di hop (es. 1) SOLO dietro un reverse
# proxy noto; il booleano globale true viene rifiutato fail-closed.
TRUST_PROXY=false

# Stripe Connect client_id (opzionale in dev, dalla dashboard Connect)
# STRIPE_CLIENT_ID=ca_...

# WorkOS AuthKit, Console e dominio platform (Wave 9C.0B/9C.0C)
# Tutti i 9 valori sono obbligatori anche in sviluppo; sostituire ogni placeholder.
WORKOS_API_KEY=sk_test_workos_api_key_placeholder
WORKOS_CLIENT_ID=client_workos_client_id_placeholder
WORKOS_COOKIE_PASSWORD=min_32_chars_cookie_password_secret_here!
WORKOS_WEBHOOK_SECRET=whsec_workos_webhook_secret_placeholder
WORKOS_REDIRECT_URI=http://console.localhost:3001/api/auth/callback
WORKOS_POST_LOGOUT_REDIRECT_URI=http://console.localhost:3001
CONSOLE_ORIGIN=http://console.localhost:3001
AUTH_AUDIT_HMAC_SECRET=min_32_chars_auth_audit_hmac_secret_here!
PLATFORM_ROOT_DOMAIN=sauta.test
